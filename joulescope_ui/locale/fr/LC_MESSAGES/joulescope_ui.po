#: widgets/waveform/waveform_control.py:24
msgid ""
"To reposition the marker, left click on the marker, move the mouse to the "
"new location, and the left click again."
msgstr ""
"Pour repositionner le marqueur, cliquez avec le bouton gauche de la souris "
"sur le marqueur, déplacez la souris vers le nouvel emplacement et cliquez à "
"nouveau avec le bouton gauche de la souris."

#: widgets/waveform/waveform_control.py:31
msgid "Click to add a single marker to the waveform."
msgstr "Cliquez pour ajouter un seul marqueur à la forme d'onde."

#: widgets/waveform/waveform_control.py:33
msgid ""
"You can also add a marker by right-clicking on the x-axis or in the plot "
"area."
msgstr ""
"Vous pouvez également ajouter un marqueur en cliquant avec le bouton droit "
"de la souris sur l'axe des x ou dans la zone de tracé."

#: widgets/waveform/waveform_control.py:40
msgid "Click to add a dual markers to the waveform."
msgstr "Cliquez pour ajouter un double marqueur à la forme d'onde."

#: widgets/waveform/waveform_control.py:42
msgid ""
"You can also add a dual markers by right-clicking on the x-axis or in the "
"plot area."
msgstr ""
"Vous pouvez également ajouter un double marqueur en cliquant avec le bouton "
"droit de la souris sur l'axe des x ou dans la zone de tracé."

#: widgets/waveform/waveform_control.py:47
msgid "Clear all markers"
msgstr "Effacer tous les marqueurs"

#: widgets/waveform/waveform_control.py:48
msgid ""
"Click to clear all markers from the waveform. This operation removes both "
"single markers and dual markers."
msgstr ""
"Cliquez pour effacer tous les marqueurs de la forme d'onde. Cette opération "
"supprime à la fois les marqueurs simples et les marqueurs doubles."

#: widgets/waveform/waveform_control.py:53
msgid "Zoom in"
msgstr "Zoom avant"

#: widgets/waveform/waveform_control.py:55
msgid "Click to zoom in along the time x-axis."
msgstr "Cliquez pour zoomer sur l'axe des x du temps."

#: widgets/waveform/waveform_control.py:56
#: widgets/waveform/waveform_control.py:64
msgid ""
"You can also zoom by positioning the mouse over the waveform and then using "
"the scroll wheel."
msgstr ""
"Vous pouvez également zoomer en positionnant la souris sur la forme d'onde "
"et en utilisant la molette de défilement."

#: widgets/waveform/waveform_control.py:61
msgid "Zoom out"
msgstr "Zoom arrière"

#: widgets/waveform/waveform_control.py:63
msgid "Click to zoom out along the time x-axis."
msgstr "Cliquez pour faire un zoom arrière sur l'axe des x du temps."

#: widgets/waveform/waveform_control.py:69
msgid "Zoom all"
msgstr "Zoom sur tout"

#: widgets/waveform/waveform_control.py:70
msgid "Click to display the full extents of the x-axis."
msgstr "Cliquez pour afficher l'étendue complète de l'axe des x."

#: widgets/waveform/waveform_control.py:73
msgid "Pin left"
msgstr "Épingler à gauche"

#: widgets/waveform/waveform_control.py:74
msgid ""
"Pin the waveform display to the left side. When enabled, the left side "
"(oldest) data always remains in view."
msgstr ""
"Épingle l'affichage de la forme d'onde sur le côté gauche. Lorsque cette "
"option est activée, les données du côté gauche (les plus anciennes) restent "
"toujours visibles."

#: widgets/waveform/waveform_control.py:79
msgid "Pin right"
msgstr "Épingler à droite"

#: widgets/waveform/waveform_control.py:80
msgid ""
"Pin the waveform display to the right side. When enabled, the right side "
"(newest) data always remains in view."
msgstr ""
"Épingle l'affichage de la forme d'onde sur le côté droit. Lorsque cette "
"option est activée, les données du côté droit (les plus récentes) restent "
"toujours visibles."

#: widgets/waveform/waveform_control.py:85
msgid "Pin"
msgstr "Épingler"

#: widgets/waveform/waveform_control.py:86
msgid ""
"Pin the waveform display to one side. Pins are not available when viewing a "
"file, which has fixed extents."
msgstr ""
"Épinglez l'affichage de la forme d'onde sur un côté. Les épingles ne sont "
"pas disponibles lors de la visualisation d'un fichier, dont l'étendue est "
"fixe."

#: widgets/waveform/waveform_control.py:91
msgid "Y zoom all"
msgstr "Zoom Y sur tout"

#: widgets/waveform/waveform_control.py:93
msgid "Click to reset the y-axis of all plots to auto ranging mode."
msgstr ""
"Cliquez sur ce bouton pour réinitialiser l'axe des ordonnées de tous les "
"tracés en mode d'échelonnement automatique."

#: widgets/waveform/waveform_control.py:94
msgid ""
"This operation does not affect the fixed range plots such as the general "
"purpose inputs."
msgstr ""
"Cette opération n'affecte pas les tracés à plage fixe tels que les entrées à"
" usage général."

#: widgets/waveform/waveform_control.py:99
msgid "Show min/max extents"
msgstr "Afficher les étendues min/max"

#: widgets/waveform/waveform_control.py:101
msgid ""
"Change how the waveform shows the min/max extents. When zoomed out, each "
"pixel may represent many samples. Displaying the min/max can allow you to "
"see events that may be missed with just the average."
msgstr ""
"Modifier la façon dont la forme d'onde affiche les étendues min/max. En cas "
"de zoom arrière, chaque pixel peut représenter de nombreux échantillons. "
"L'affichage des valeurs min/max peut vous permettre de voir des événements "
"que vous n'auriez pas remarqués si vous n'aviez que la moyenne."

#: widgets/waveform/waveform_control.py:105
msgid "\"off\" only displays the average."
msgstr "« désactivé » n'affiche que la moyenne."

#: widgets/waveform/waveform_control.py:106
msgid "\"lines\" displays the minimum and maximum as separate line traces."
msgstr ""
"\"lignes\" affiche le minimum et le maximum sous forme de lignes distinctes."

#: widgets/waveform/waveform_control.py:107
msgid "\"fill 1\" displays a filled color between the minimum and maximum."
msgstr ""
"« remplir 1 » affiche une couleur remplie entre le minimum et le maximum."

#: widgets/waveform/waveform_control.py:108
msgid "\"fill 2\" also displays an additional fill for standard deviation."
msgstr ""
"« remplir 2 » affiche également un remplissage supplémentaire pour l'écart-"
"type."

#: widgets/waveform/waveform_control.py:112
msgid "Show/hide signals"
msgstr "Afficher/masquer les signaux"

#: widgets/waveform/waveform_control.py:113
msgid "Click to toggle the signal axis display in the Waveform widget."
msgstr ""
"Cliquez pour basculer l'affichage de l'axe du signal dans le widget Forme "
"d'onde."

