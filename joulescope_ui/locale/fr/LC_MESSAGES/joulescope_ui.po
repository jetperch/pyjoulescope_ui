#: about.py:24
msgid "About the Joulescope UI"
msgstr "A propos de l'interface utilisateur Joulescope"

#: about.py:25
msgid "Version Information"
msgstr "Information sur la version"

#: about.py:37 main.py:298
msgid "UI"
msgstr "Interface utilisateur"

#: about.py:41
msgid "Platform"
msgstr "Plateforme"

