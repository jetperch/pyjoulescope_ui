#: widgets/waveform/waveform_control.py:24
msgid ""
"To reposition the marker, left click on the marker, move the mouse to the "
"new location, and the left click again."
msgstr ""
"Για να επανατοποθετήσετε το δείκτη, κάντε αριστερό κλικ στο δείκτη, "
"μετακινήστε το ποντίκι στη νέα θέση και κάντε ξανά αριστερό κλικ."

#: widgets/waveform/waveform_control.py:31
msgid "Click to add a single marker to the waveform."
msgstr "Κάντε κλικ για να προσθέσετε έναν μεμονωμένο δείκτη στην κυματομορφή."

#: widgets/waveform/waveform_control.py:33
msgid ""
"You can also add a marker by right-clicking on the x-axis or in the plot "
"area."
msgstr ""
"Μπορείτε επίσης να προσθέσετε έναν δείκτη κάνοντας δεξί κλικ στον άξονα x ή "
"στην περιοχή γραφικής παράστασης."

#: widgets/waveform/waveform_control.py:40
msgid "Click to add a dual markers to the waveform."
msgstr "Κάντε κλικ για να προσθέσετε έναν διπλό δείκτη στην κυματομορφή."

#: widgets/waveform/waveform_control.py:42
msgid ""
"You can also add a dual markers by right-clicking on the x-axis or in the "
"plot area."
msgstr ""
"Μπορείτε επίσης να προσθέσετε έναν διπλό δείκτη κάνοντας δεξί κλικ στον "
"άξονα x ή στην περιοχή γραφικής παράστασης."

#: widgets/waveform/waveform_control.py:47
msgid "Clear all markers"
msgstr "Εκκαθάριση όλων των δεικτών"

#: widgets/waveform/waveform_control.py:48
msgid ""
"Click to clear all markers from the waveform. This operation removes both "
"single markers and dual markers."
msgstr ""
"Κάντε κλικ για να διαγράψετε όλους τους δείκτες από την κυματομορφή. Η "
"λειτουργία αυτή αφαιρεί τόσο τους απλούς όσο και τους διπλούς δείκτες."

#: widgets/waveform/waveform_control.py:53
msgid "Zoom in"
msgstr "Μεγέθυνση"

#: widgets/waveform/waveform_control.py:55
msgid "Click to zoom in along the time x-axis."
msgstr "Κάντε κλικ για μεγέθυνση κατά μήκος του άξονα x του χρόνου."

#: widgets/waveform/waveform_control.py:56
#: widgets/waveform/waveform_control.py:64
msgid ""
"You can also zoom by positioning the mouse over the waveform and then using "
"the scroll wheel."
msgstr ""
"Μπορείτε επίσης να κάνετε ζουμ τοποθετώντας το ποντίκι πάνω στην κυματομορφή"
" και στη συνέχεια χρησιμοποιώντας τον τροχό κύλισης."

#: widgets/waveform/waveform_control.py:61
msgid "Zoom out"
msgstr "Σμίκρυνση"

#: widgets/waveform/waveform_control.py:63
msgid "Click to zoom out along the time x-axis."
msgstr "Κάντε κλικ για σμίκρυνση κατά μήκος του άξονα x του χρόνου."

#: widgets/waveform/waveform_control.py:69
msgid "Zoom all"
msgstr "Εμφάνιση όλων"

#: widgets/waveform/waveform_control.py:70
msgid "Click to display the full extents of the x-axis."
msgstr "Κάντε κλικ για να εμφανίσετε τα πλήρη όρια του άξονα x."

#: widgets/waveform/waveform_control.py:73
msgid "Pin left"
msgstr "Καρφίτσωμα αριστερά"

#: widgets/waveform/waveform_control.py:74
msgid ""
"Pin the waveform display to the left side. When enabled, the left side "
"(oldest) data always remains in view."
msgstr ""
"Καρφιτσώστε την οθόνη κυματομορφής στην αριστερή πλευρά. Όταν είναι "
"ενεργοποιημένη, τα δεδομένα της αριστερής πλευράς (παλαιότερα) παραμένουν "
"πάντα σε προβολή."

#: widgets/waveform/waveform_control.py:79
msgid "Pin right"
msgstr "Καρφίτσωμα δεξιά"

#: widgets/waveform/waveform_control.py:80
msgid ""
"Pin the waveform display to the right side. When enabled, the right side "
"(newest) data always remains in view."
msgstr ""
"Καρφιτσώστε την οθόνη κυματομορφής στη δεξιά πλευρά. Όταν είναι "
"ενεργοποιημένη, τα δεδομένα της δεξιάς πλευράς (τα νεότερα) παραμένουν πάντα"
" σε προβολή."

#: widgets/waveform/waveform_control.py:85
msgid "Pin"
msgstr "Καρφίτσωμα"

#: widgets/waveform/waveform_control.py:86
msgid ""
"Pin the waveform display to one side. Pins are not available when viewing a "
"file, which has fixed extents."
msgstr ""
"Καρφιτσώστε την απεικόνιση της κυματομορφής στη μία πλευρά. Οι καρφίτσες δεν"
" είναι διαθέσιμες κατά την προβολή ενός αρχείου, το οποίο έχει σταθερά όρια."

#: widgets/waveform/waveform_control.py:91
msgid "Y zoom all"
msgstr "Εμφάνιση όλων (Y)"

#: widgets/waveform/waveform_control.py:93
msgid "Click to reset the y-axis of all plots to auto ranging mode."
msgstr ""
"Κάντε κλικ για να επαναφέρετε τον άξονα y όλων των γραφικών παραστάσεων σε "
"λειτουργία αυτόματου εύρους."

#: widgets/waveform/waveform_control.py:94
msgid ""
"This operation does not affect the fixed range plots such as the general "
"purpose inputs."
msgstr ""
"Αυτή η λειτουργία δεν επηρεάζει τις απεικονίσεις σταθερής κλίμακας, όπως οι "
"είσοδοι γενικής χρήσης."

#: widgets/waveform/waveform_control.py:99
msgid "Show min/max extents"
msgstr "Εμφάνιση ορίων ελάχιστου/μέγιστου"

#: widgets/waveform/waveform_control.py:101
msgid ""
"Change how the waveform shows the min/max extents. When zoomed out, each "
"pixel may represent many samples. Displaying the min/max can allow you to "
"see events that may be missed with just the average."
msgstr ""
"Αλλάξτε τον τρόπο με τον οποίο η κυματομορφή εμφανίζει τα όρια "
"ελάχιστου/μέγιστου. Σε σμίκρυνση, κάθε εικονοστοιχείο μπορεί να "
"αντιπροσωπεύει πολλά δείγματα. Η εμφάνιση των ελάχιστων/μέγιστων μπορεί να "
"σας επιτρέψει να δείτε γεγονότα που μπορεί να σας διαφύγουν με τη χρήση μόνο"
" του μέσου όρου."

#: widgets/waveform/waveform_control.py:105
msgid "\"off\" only displays the average."
msgstr "«ανενεργό» εμφανίζει μόνο τον μέσο όρο."

#: widgets/waveform/waveform_control.py:106
msgid "\"lines\" displays the minimum and maximum as separate line traces."
msgstr ""
"«γραμμές» εμφανίζει το ελάχιστο και το μέγιστο ως ξεχωριστά ίχνη γραμμής."

#: widgets/waveform/waveform_control.py:107
msgid "\"fill 1\" displays a filled color between the minimum and maximum."
msgstr ""
"«γέμισμα 1» εμφανίζει ένα γεμάτο χρώμα μεταξύ του ελάχιστου και του "
"μέγιστου."

#: widgets/waveform/waveform_control.py:108
msgid "\"fill 2\" also displays an additional fill for standard deviation."
msgstr ""
"«γέμισμα 2» εμφανίζει επίσης ένα πρόσθετο γέμισμα για την τυπική απόκλιση."

#: widgets/waveform/waveform_control.py:112
msgid "Show/hide signals"
msgstr "Εμφάνιση/απόκρυψη σημάτων"

#: widgets/waveform/waveform_control.py:113
msgid "Click to toggle the signal axis display in the Waveform widget."
msgstr ""
"Κάντε κλικ για εμφάνιση/απόκρυψη του άξονα σήματος στο γραφικό στοιχείο "
"«Κυματομορφή»."

#: widgets/waveform/waveform_control.py:138
msgid "Markers:"
msgstr "Δείκτες:"

#: widgets/waveform/waveform_control.py:146
msgid "X-Axis:"
msgstr "Άξονας X:"

#: widgets/waveform/waveform_control.py:162
msgid "Min/Max:"
msgstr "Ελάχ./Μέγ.:"

#: widgets/waveform/waveform_control.py:173
msgid "Signals:"
msgstr "Σήματα:"

#: widgets/waveform/waveform_source_widget.py:30
msgid "Enable trace"
msgstr "Ενεργοποίηση ίχνους"

#: widgets/waveform/waveform_source_widget.py:32
msgid "Click to toggle this trace."
msgstr "Κάντε κλικ για ενεργοποίηση/απενεργοποίηση αυτού του ίχνους."

#: widgets/waveform/waveform_source_widget.py:33
msgid "When enabled, the waveform will display this trace."
msgstr "Όταν είναι ενεργοποιημένο, η κυματομορφή θα εμφανίζει αυτό το ίχνος."

