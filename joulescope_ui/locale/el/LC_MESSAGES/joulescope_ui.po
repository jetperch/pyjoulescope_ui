msgstr "Ρύθμιση της καταγραφής στατιστικών στοιχείων"

#: widgets/trigger/trigger_widget.py:41 widgets/value/value_widget.py:118
msgid "Select the source device"
msgstr "Επιλέξτε τη συσκευή πηγής"

#: widgets/trigger/trigger_widget.py:42
