msgstr "Η μορφή χρόνου κατά το πέρασμα του ποντικιού."

#: widgets/waveform/waveform_widget.py:448
msgid "Relative to view"
msgstr "Σε σχέση με την προβολή"

#: widgets/waveform/waveform_widget.py:449
